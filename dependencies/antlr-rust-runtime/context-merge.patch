+        // merge return immediately instead of consuming native stack per edge.
+        let mut pending = vec![(left, right, false)];
+        while let Some((left, right, ready)) = pending.pop() {
+            let key = MergeKey::new(left, right, root_is_wildcard);
+            if left == right || workspace.merge_cache.contains_key(&key) {
+                continue;
+            }
+            if root_is_wildcard && (left == EMPTY_CONTEXT || right == EMPTY_CONTEXT) {
+                workspace.merge_cache.insert(key, EMPTY_CONTEXT);
