{
  "schema_version": "1.0.0",
  "agents": {
    "database": {
      "responsibilities": "Oracle data model, database behavior, migration execution, and database contracts",
      "path_policy": [
        "apps/worker/**",
        "packages/**",
        "experiments/**"
      ]
    },
    "backend": {
      "responsibilities": "Application services, governance workflows, APIs, and durable state contracts",
      "path_policy": [
        "apps/api/**",
        "packages/**"
      ]
    },
    "frontend": {
      "responsibilities": "User-facing workflows, accessible views, and client integration",
      "path_policy": [
        "apps/web/**",
        "packages/**"
      ]
    },
    "security": {
      "responsibilities": "Identity, authorization, secret handling, threat boundaries, and security evidence",
      "path_policy": [
        "apps/api/**",
        "apps/worker/**",
        "packages/**"
      ]
    },
    "qa": {
      "responsibilities": "Acceptance traceability, test design, evidence quality, and release gates",
      "path_policy": [
        "tests/**",
        "experiments/**",
        "docs/implementation/**"
      ]
    },
    "devops": {
      "responsibilities": "Build, Git/provider integration, operations, packaging, and deployment contracts",
      "path_policy": [
        "scripts/**",
        "experiments/**",
        ".github/**"
      ]
    },
    "orchestrator": {
      "responsibilities": "Cross-domain integration, shared contracts, and milestone coordination",
      "path_policy": [
        "docs/implementation/**"
      ]
    }
  },
