{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/db-devops/feature-catalog.schema.json",
  "title": "Database DevOps research feature catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "research_date",
    "scope",
    "evidence_levels",
    "features"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "research_date": {
      "const": "2026-10-08"
    },
    "scope": {
      "type": "string"
    },
    "evidence_levels": {
      "type": "array",
      "items": {
        "enum": [
          "SOURCE_VERIFIED",
          "DOC_VERIFIED",
          "RUNTIME_VERIFIED",
          "DESIGN_PROPOSAL",
          "UNKNOWN",
          "NOT_TESTED"
        ]
      }
    },
    "features": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/feature"
      }
    }
  },
  "$defs": {
    "feature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "domain",
        "description",
        "personas",
        "source_products",
        "source_evidence",
        "reference_scope",
        "bytebase_native",
        "current_source_availability",
        "license_edition_limitations",
        "expected_behavior",
        "oracle_considerations",
        "security_considerations",
        "dependencies",
        "implementation_complexity",
        "operational_value",
        "classification",
        "priority",
        "moscow",
        "recommended_release",
        "acceptance_criteria",
        "design_reference",
        "implementation_status",
        "runtime_status",
        "evidence_level",
        "verification_scope"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^(DBM|PRJ|MIG|GOV|SQL|SEC|GIT|OPS|EXT)-[0-9]{3}$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "domain": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "personas": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "source_products": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "source_evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "evidence_id",
              "level",
              "url",
              "scope"
            ],
            "properties": {
              "evidence_id": {
                "type": "string"
              },
              "level": {
                "enum": [
                  "SOURCE_VERIFIED",
                  "DOC_VERIFIED",
                  "RUNTIME_VERIFIED",
                  "DESIGN_PROPOSAL",
                  "UNKNOWN",
                  "NOT_TESTED"
                ]
              },
              "url": {
                "type": "string",
                "minLength": 1
              },
              "scope": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "reference_scope": {
          "type": "string",
          "minLength": 1
        },
        "bytebase_native": {
          "enum": [
            "SOURCE_VERIFIED",
            "PARTIAL_SOURCE_SCOPE",
            "PARTIAL",
            "NOT_FOUND_IN_REVIEW",
            "UNKNOWN"
          ]
        },
        "current_source_availability": {
          "type": "string",
          "minLength": 1
        },
        "license_edition_limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "expected_behavior": {
          "type": "string",
          "minLength": 1
        },
        "oracle_considerations": {
          "type": "string",
          "minLength": 1
        },
        "security_considerations": {
          "type": "string",
          "minLength": 1
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "implementation_complexity": {
          "enum": [
            "S",
            "M",
            "L",
            "NOT_ESTIMATED"
          ]
        },
        "operational_value": {
          "type": "string",
          "minLength": 1
        },
        "classification": {
          "enum": [
            "BASELINE",
            "ENHANCEMENT",
            "DIFFERENTIATOR",
            "OPTIONAL",
            "REJECTED"
          ]
        },
        "priority": {
          "type": "string",
          "minLength": 1
        },
        "moscow": {
          "type": "string",
          "minLength": 1
        },
        "recommended_release": {
          "enum": [
            "MVP",
            "V1",
            "V2",
            "REJECTED"
          ]
        },
        "acceptance_criteria": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "design_reference": {
          "type": "string",
          "minLength": 1
        },
        "implementation_status": {
          "const": "DESIGN_PROPOSAL"
        },
        "runtime_status": {
          "const": "NOT_TESTED"
        },
        "evidence_level": {
          "enum": [
            "SOURCE_VERIFIED",
            "DOC_VERIFIED",
            "RUNTIME_VERIFIED",
            "DESIGN_PROPOSAL",
            "UNKNOWN",
            "NOT_TESTED"
          ]
        },
        "verification_scope": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
