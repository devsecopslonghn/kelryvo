+test('browser session admission preserves bounded OS rotation journal under concurrent capacity and expiry',{skip:!enabled,timeout:60000},async()=>{
+  const db=await openIsolatedProductDatabase(),fixture=await createTlsFixture();let app;
+  const actors=[{id:'local-developer',name:'Capacity developer',role:'developer',token:randomBytes(32).toString('hex')},{id:'local-approver',name:'Capacity approver',role:'approver',token:randomBytes(32).toString('hex')}];
+  try{
+    app=await startProduct({databaseUrl:db.databaseUrl,actors,repositories:[],port:0,tls:fixture.tls});
+    const base=`https://127.0.0.1:${app.server.address().port}`;
+    const login=(actor=actors[0],cookie)=>tlsRequest(base,fixture.ca,'/api/session',{method:'POST',headers:{authorization:`Bearer ${actor.token}`,origin:base,...(cookie?{cookie}:{})}});
+    const cookie=signed=>signed.headers['set-cookie'][0].split(';')[0];
+    const sessions=[];
+    for(let i=0;i<30;i++){const signed=await login();assert.equal(signed.status,200);sessions.push(cookie(signed));}
+    const concurrent=await Promise.all([login(),login()]);assert.deepEqual(concurrent.map(x=>x.status).sort(),[200,429]);
+    const denied=concurrent.find(x=>x.status===429);assert.equal(denied.body.error,'SESSION_CAPACITY_REACHED');assert.equal(denied.headers['set-cookie'],undefined);
+    const count=async()=>Number((await db.sql`SELECT count(*) FROM sf_local_credentials WHERE actor_id=${actors[0].id} AND revoked_at IS NULL`)[0].count);
+    assert.equal(await count(),32,'concurrent clients cannot exceed existing operator journal capacity');
+    const replacement=await login(actors[0],sessions[0]);assert.equal(replacement.status,200);assert.equal(await count(),32);
+    assert.equal((await tlsRequest(base,fixture.ca,'/api/session',{headers:{cookie:sessions[0]}})).status,401);
+    const approver=await login(actors[1]);assert.equal(approver.status,200);
+    const switchDenied=await login(actors[0],cookie(approver));assert.equal(switchDenied.status,429);
+    assert.equal((await tlsRequest(base,fixture.ca,'/api/session',{headers:{cookie:cookie(approver)}})).status,200,'capacity failure rolls back replacement revocation');
+    const expiredDigest=tokenDigest(sessions[1].split('=')[1]);
+    await db.sql`UPDATE sf_local_credentials SET issued_at=now()-interval '1 hour',expires_at=now()-interval '1 minute',absolute_expires_at=now()+interval '7 hours' WHERE token_sha256=${expiredDigest}`;
+    const recovered=await login();assert.equal(recovered.status,200);assert.equal(await count(),32);
+    assert.ok((await db.sql`SELECT revoked_at FROM sf_local_credentials WHERE token_sha256=${expiredDigest}`)[0].revoked_at,'expired session history is retained and marked revoked');
+    const configPath=join(fixture.directory,'config.json'),password=randomBytes(32).toString('hex'),privateUrl=new URL(db.databaseUrl);privateUrl.password=password;
+    await writeFile(configPath,JSON.stringify({databasePassword:password,developerToken:actors[0].token,approverToken:actors[1].token}),{mode:0o600});
+    await operateLocalCredential({configPath,databaseUrl:privateUrl.toString(),identity:'developer',action:'rotate'});
+    assert.equal(await count(),1,'OS rotation at capacity revokes all sessions and issues one local credential');
+    for(const oldCookie of [...sessions,cookie(replacement),cookie(recovered)])assert.equal((await tlsRequest(base,fixture.ca,'/api/session',{headers:{cookie:oldCookie}})).status,401);
+    actors[0].token=JSON.parse(await readFile(configPath,'utf8')).developerToken;
+    const rotated=await login();assert.equal(rotated.status,200);
+    await operateLocalCredential({configPath,databaseUrl:privateUrl.toString(),identity:'developer',action:'revoke'});
+    assert.equal((await tlsRequest(base,fixture.ca,'/api/session',{headers:{cookie:cookie(rotated)}})).status,401);
+  }finally{await app?.close();await db.close();await fixture.close();}
+});
