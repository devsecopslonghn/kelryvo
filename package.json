{
  "name": "kelryvo-native-test-tools",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Development and migration checks for the native Rust application",
  "engines": {
    "node": "22.23.3",
    "npm": "10.9.9"
  },
  "scripts": {
    "build": "cargo build --workspace --locked && target/debug/kelryvo build-web",
    "build:web": "cargo run --locked -p kelryvo-cli --bin kelryvo -- build-web",
    "dev": "cargo build --workspace --locked && target/debug/kelryvo dev",
    "local:prepare": "cargo build --workspace --locked && target/debug/kelryvo local-prepare",
    "operator": "cargo run --locked -p kelryvo-operator --bin kelryvo-operator --",
    "worker:service": "cargo run --locked -p kelryvo-worker --bin kelryvo-worker -- execution-service",
    "release:local": "cargo run --locked -p kelryvo-cli --bin kelryvo -- build-dist",
    "test": "bash scripts/test-rust.sh",
    "test:product": "bash scripts/test-rust.sh --product-and-json-objects-only",
    "test:browser": "bash scripts/test-rust.sh --browser-only",
    "test:browser:smoke": "bash scripts/test-rust.sh --browser-product-only",
    "parser:corpus": "cargo test --locked -p kelryvo-parser --test corpus -p kelryvo-oracle-grammar --test corpus",
    "parser:build:offline": "cargo build --locked -p kelryvo-parser",
    "lint": "npm run hygiene:check && node scripts/check-source.mjs && node scripts/checklist.mjs validate",
    "format:check": "node scripts/format-json.mjs --check",
    "format": "node scripts/format-json.mjs --write",
    "hygiene:check": "python3 scripts/check-repository.py",
    "check": "npm run check:delivery",
    "check:fast": "npm run check:delivery",
    "check:delivery": "npm run lint && npm run format:check && npm run test:delivery && npm run dependencies:product",
    "check:full": "npm run check:delivery && bash scripts/test-rust.sh",
    "test:delivery": "node --test tests/native-delivery.test.mjs && python3 tests/test_oracle_ack_proxy.py",
    "dependencies:product": "node scripts/test-tool-dependencies.mjs",
    "dependencies:manifest": "node scripts/test-tool-dependencies.mjs --manifest",
    "status": "node scripts/checklist.mjs status",
    "next": "node scripts/checklist.mjs next"
  },
  "devDependencies": {
    "oracledb": "7.0.1",
    "playwright": "1.64.0",
    "postgres": "3.4.9"
  },
  "packageManager": "npm@10.9.9",
  "license": "SEE LICENSE IN LICENSE"
}
