{
  "name": "kelryvo-local-development",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Source-available Kelryvo local governance product and preserved Oracle validation harness",
  "engines": {
    "node": "22.23.3",
    "npm": "10.9.9"
  },
  "scripts": {
    "build": "node scripts/check-source.mjs && npm run typecheck && npm run build:web",
    "lint": "npm run hygiene:check && node scripts/check-source.mjs && node scripts/checklist.mjs validate",
    "format:check": "node scripts/format-json.mjs --check",
    "format": "node scripts/format-json.mjs --write",
    "test": "node --test --test-concurrency=2 tests/*.test.mjs",
    "check": "npm run check:delivery",
    "check:fast": "npm run check:delivery",
    "check:record": "node scripts/record-checks.mjs",
    "status": "node scripts/checklist.mjs status",
    "next": "node scripts/checklist.mjs next",
    "preflight": "node experiments/db-devops-wp0/preflight.mjs",
    "dependencies:smoke": "node experiments/db-devops-wp0/dependencies/smoke.mjs",
    "dependencies:manifest": "node scripts/dependency-artifacts.mjs manifest",
    "dependencies:offline": "node scripts/dependency-artifacts.mjs offline-check --smoke experiments/db-devops-wp0/dependencies/smoke.mjs",
    "parser:corpus": "node scripts/parser-corpus.mjs",
    "parser:build:offline": "node scripts/parser-build.mjs",
    "parser:antlr:prepare": "node scripts/antlr-prepare.mjs --download",
    "parser:antlr:build": "node scripts/antlr-build.mjs",
    "parser:antlr:corpus": "node scripts/parser-corpus.mjs --antlr",
    "parser:antlr:test": "node --test tests/antlr.integration.mjs",
    "probes:thin:plan": "node scripts/thin-probe-plan.mjs",
    "typecheck": "tsc --noEmit",
    "build:web": "node scripts/build-web.mjs",
    "local:prepare": "node scripts/local-prepare.mjs",
    "local:credentials": "node scripts/local-credential-operator.mjs",
    "local:password": "node scripts/local-password-operator.mjs",
    "local:backup-restore": "node scripts/local-backup-operator.mjs",
    "local:membership": "node scripts/local-membership-operator.mjs",
    "local:execution-recovery": "node scripts/local-execution-recovery.mjs",
    "worker:service": "node apps/worker/execution-service-main.mjs",
    "dev": "npm run build:web && node scripts/local-dev.mjs",
    "test:product": "node scripts/test-product.mjs",
    "test:browser": "npm run build:web && node scripts/test-product.mjs --browser",
    "test:browser:smoke": "npm run build:web && node scripts/test-product.mjs --browser --smoke",
    "test:browser:extended": "npm run build:web && node scripts/test-product.mjs --browser --extended",
    "dependencies:product": "node scripts/product-dependencies.mjs",
    "release:local": "node scripts/local-release.mjs build",
    "test:release": "node --test tests/product-local-release.integration.mjs",
    "local:identity-admin": "node scripts/local-identity-admin.mjs",
    "hygiene:check": "python3 scripts/check-repository.py",
    "check:delivery": "npm run hygiene:check && npm run build && node scripts/checklist.mjs validate && npm run format:check && npm run test:delivery && npm run dependencies:product",
    "test:delivery": "node --test --test-concurrency=2 tests/container-delivery.test.mjs tests/oci-archive-verification.test.mjs tests/container-config.test.mjs tests/container-repositories.test.mjs tests/local-release.test.mjs tests/antlr-download.test.mjs tests/antlr-prepare.test.mjs tests/checklist.test.mjs && python3 tests/test_pilot_setup.py",
    "check:full": "npm run hygiene:check && npm run build && node scripts/checklist.mjs validate && npm run format:check && npm test && npm run dependencies:smoke && npm run dependencies:product"
  },
  "dependencies": {
    "@fastify/rate-limit": "11.2.1",
    "fastify": "5.12.5",
    "ldapts": "9.2.0",
    "openid-client": "6.8.8",
    "oracledb": "7.0.1",
    "postgres": "3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "esbuild": "0.28.2",
    "playwright": "1.64.0",
    "typescript": "6.0.2"
  },
  "packageManager": "npm@10.9.9",
  "license": "SEE LICENSE IN LICENSE"
}
